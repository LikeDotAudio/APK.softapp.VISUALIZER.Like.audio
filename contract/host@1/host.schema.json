{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viz.like.audio/contract/host@1/host.schema.json",
  "title": "viz.like.audio/host@1",
  "description": "The VISUALIZER.Like.audio host bridge: window.postMessage between a viewer (2d, 3d, 4d or analyzer — one page each, in an iframe or a window it was opened in) and the app hosting it. Every message is { protocol: 'viz.like.audio/host@1', type, ...body }. $defs 'toViewer.<type>' are what a host may send; 'toHost.<type>' are what a viewer sends. The viewer knows nothing about any dataset: it reads the contents of `data` and infers what each field is. Fields not listed are ignored by the receiver, so a new optional field stays @1; renaming or removing one is @2. Validate with ../validate.mjs (the CAD's validator, vendored unchanged); samples.json carries one sample of every message.",
  "x-protocol": "viz.like.audio/host@1",
  "x-transport": "window.postMessage. The viewer hears only its parent (or opener) window and answers to the origin that last spoke to it; a host checks event.source is its iframe.",
  "$defs": {
    "kind": {
      "description": "What a field holds, as the viewer reads it from the contents: number (finite numbers), category (a small set of repeated values), time (ISO-8601 dates, or epoch numbers a hint declares), vector (equal-length arrays of numbers: an embedding), id (unique per record), label (the human name of a record), color (CSS colour strings), text (long or unique strings nothing is plotted by).",
      "enum": [
        "number",
        "category",
        "time",
        "vector",
        "id",
        "label",
        "color",
        "text"
      ]
    },
    "fieldHint": {
      "description": "What the host knows about one field. Every key is optional; anything not said is inferred from the contents.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "label": {
          "type": "string",
          "description": "Display name; the field's own name otherwise."
        },
        "unit": {
          "type": "string"
        },
        "order": {
          "description": "category: the values in the order to lay them out (and, on the 4D ball, the order faces are dealt). Values not listed follow, sorted.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "colors": {
          "description": "category: a CSS colour per value. Values not listed take the viewer's palette.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "hidden": {
          "description": "Never offered as an axis or colour (it still shows on hover and in the Analyzer).",
          "type": "boolean"
        }
      }
    },
    "view": {
      "description": "What the viewer is drawing by: field names per role (null = none). Each viewer reads the roles it has and ignores the rest. Sent both ways: the host proposes, the viewer reports what the user picked.",
      "type": "object",
      "properties": {
        "x": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "y": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "z": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "size": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "shape": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "face": {
          "description": "4d: the category whose values are the ball's faces (up to 32; the rest share the last face).",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "faceGroup": {
          "description": "4d: a category that colours the faces (the face's majority value).",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "corners": {
          "description": "4d: up to six number fields weighting a face's corners.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 6
        },
        "signs": {
          "description": "Per spatial axis, 1 or -1 (flip).",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "pull": {
          "type": "number",
          "description": "4d: 0 = free scatter, 1 = seated on its face, up to 2 = overshoot."
        },
        "cornerPull": {
          "type": "number",
          "description": "4d: 0..1"
        },
        "outline": {
          "type": "number",
          "description": "4d: cage brightness 0..2"
        },
        "faceIntensity": {
          "type": "number",
          "description": "4d: face patch brightness 0..2"
        },
        "axes": {
          "description": "Draw the axes / cage labels.",
          "type": "boolean"
        },
        "focus": {
          "description": "analyzer: the field opened in detail.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "preset": {
      "type": "object",
      "required": [
        "name",
        "view"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "A short button label (A, B, …)."
        },
        "name": {
          "type": "string"
        },
        "view": {
          "$ref": "#/$defs/view"
        }
      }
    },
    "schemaHint": {
      "description": "Optional. What the host knows about its records. Nothing here is required: a bare records array is enough.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The field that identifies a record (echoed in pick/select). Inferred otherwise; the record's index when there is none."
        },
        "label": {
          "type": "string",
          "description": "The field that names a record on hover."
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/fieldHint"
          }
        },
        "view": {
          "$ref": "#/$defs/view"
        },
        "presets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preset"
          }
        }
      }
    },
    "need": {
      "type": "object",
      "required": [
        "role",
        "kinds"
      ],
      "properties": {
        "role": {
          "enum": [
            "x",
            "y",
            "z",
            "color",
            "size",
            "shape",
            "face",
            "faceGroup",
            "corners",
            "focus"
          ]
        },
        "kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/kind"
          },
          "minItems": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "fieldInfo": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "count"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "label": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Records that carry a usable value."
        },
        "distinct": {
          "type": "integer",
          "minimum": 0
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "dims": {
          "type": "integer",
          "minimum": 1,
          "description": "vector: its length."
        }
      }
    },
    "toViewer.hello": {
      "description": "Say ready again (and fields/view, when there is data). A host sends it once its listener is up; the viewer also says ready unasked when it loads.",
      "type": "object",
      "required": [
        "protocol",
        "type"
      ],
      "properties": {
        "protocol": {
          "const": "viz.like.audio/host@1"
        },
        "type": {
          "const": "hello"
        }
      }
    },
    "toViewer.data": {
      "description": "The records to look at — any objects. Nested objects are read as dotted paths (a.b.c). Replaces what was there before. The viewer infers every field's kind, proposes a view, and answers `fields`.",
      "type": "object",
      "required": [
        "protocol",
        "type",
        "records"
      ],
      "properties": {
        "protocol": {
          "const": "viz.like.audio/host@1"
        },
        "type": {
          "const": "data"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "schema": {
          "$ref": "#/$defs/schemaHint"
        },
        "title": {
          "type": "string",
          "description": "Shown in the viewer's header."
        }
      }
    },
    "toViewer.select": {
      "description": "Highlight these records (by id; by index when the data has no id). An empty list clears it. `pulse` makes the highlight breathe (the host is playing it).",
      "type": "object",
      "required": [
        "protocol",
        "type",
        "ids"
      ],
      "properties": {
        "protocol": {
          "const": "viz.like.audio/host@1"
        },
        "type": {
          "const": "select"
        },
        "ids": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "pulse": {
          "type": "boolean"
        }
      }
    },
    "toViewer.view": {
      "description": "Change what the viewer draws by (any subset of roles).",
      "type": "object",
      "required": [
        "protocol",
        "type",
        "view"
      ],
      "properties": {
        "protocol": {
          "const": "viz.like.audio/host@1"
        },
        "type": {
          "const": "view"
        },
        "view": {
          "$ref": "#/$defs/view"
        }
      }
    },
    "toViewer.fly": {
      "description": "One six-axis camera input frame, each axis normalised -1..1 (+x right, +y forward, +z up; yaw/pitch/roll right-handed). 3d and 4d fly the camera by it, per second; the others ignore it. The host decides whether a frame is worth flying (stale, unverified) — the viewer flies what it is sent.",
      "type": "object",
      "required": [
        "protocol",
        "type",
        "x",
        "y",
        "z",
        "yaw",
        "pitch",
        "roll"
      ],
      "properties": {
        "protocol": {
          "const": "viz.like.audio/host@1"
        },
        "type": {
          "const": "fly"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "yaw": {
          "type": "number"
        },
        "pitch": {
          "type": "number"
        },
        "roll": {
          "type": "number"
        }
      }
    },
    "toHost.ready": {
      "description": "The viewer is listening. Says which viewer it is and the field kinds each of its roles takes.",
      "type": "object",
      "required": [
        "protocol",
        "type",
        "viewer",
        "needs"
      ],
      "properties": {
        "protocol": {
          "const": "viz.like.audio/host@1"
        },
        "type": {
          "const": "ready"
        },
        "viewer": {
          "enum": [
            "2d",
            "3d",
            "4d",
            "analyzer"
          ]
        },
        "version": {
          "type": "string",
          "description": "The bundle's version."
        },
        "needs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/need"
          }
        }
      }
    },
    "toHost.fields": {
      "description": "What the viewer read from the last `data`: every field with its inferred kind, and the view it chose (the hint's, else its own proposal).",
      "type": "object",
      "required": [
        "protocol",
        "type",
        "fields",
        "view",
        "records"
      ],
      "properties": {
        "protocol": {
          "const": "viz.like.audio/host@1"
        },
        "type": {
          "const": "fields"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldInfo"
          }
        },
        "view": {
          "$ref": "#/$defs/view"
        },
        "records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "toHost.pick": {
      "description": "The user clicked one record (or moved to it with the arrow keys).",
      "type": "object",
      "required": [
        "protocol",
        "type",
        "id",
        "index"
      ],
      "properties": {
        "protocol": {
          "const": "viz.like.audio/host@1"
        },
        "type": {
          "const": "pick"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "toHost.select": {
      "description": "The user chose a set of records (a histogram bin, a face, an outlier list).",
      "type": "object",
      "required": [
        "protocol",
        "type",
        "ids"
      ],
      "properties": {
        "protocol": {
          "const": "viz.like.audio/host@1"
        },
        "type": {
          "const": "select"
        },
        "ids": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "toHost.view": {
      "description": "The user changed what the viewer draws by.",
      "type": "object",
      "required": [
        "protocol",
        "type",
        "view"
      ],
      "properties": {
        "protocol": {
          "const": "viz.like.audio/host@1"
        },
        "type": {
          "const": "view"
        },
        "view": {
          "$ref": "#/$defs/view"
        }
      }
    },
    "toHost.error": {
      "description": "The data cannot be drawn by this viewer as sent (for example 3d with fewer than three plottable fields). The viewer shows the same sentence.",
      "type": "object",
      "required": [
        "protocol",
        "type",
        "code",
        "message"
      ],
      "properties": {
        "protocol": {
          "const": "viz.like.audio/host@1"
        },
        "type": {
          "const": "error"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
